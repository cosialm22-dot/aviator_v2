// The public Supabase URL and anon key are the same values shipped in the browser bundle (.env.production).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aviatorv2",
  "compatibility_date": "2026-06-17",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/sounds/*",
      "!/planes/*",
      "!/icons/*",
      "!/sw.js",
      "!/plane.png",
      "!/favicon.ico",
      "!/favicon.png",
      "!/favicon-32.png",
      "!/apple-touch-icon.png",
      "!/offline.html"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://yhfxgzfmcwinpgmzcgma.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_WpMAoTp3loBI2eco-m0zKg_dQyIzoqD"
  }
}
